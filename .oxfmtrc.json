{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "printWidth": 100,
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all",
    "insertFinalNewline": true,
    "ignorePatterns": ["dist", "coverage", "pnpm-lock.yaml", "package-lock.json"]
}
